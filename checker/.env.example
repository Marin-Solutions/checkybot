# Copy the database and APP_KEY values from the Laravel .env on the server.
# Do not commit the filled file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=checkybot
DB_USERNAME=
DB_PASSWORD=
APP_KEY=
APP_TIMEZONE=UTC

# How many checks may run at once. Keep this low while RAM is tight.
CHECKER_CONCURRENCY=8
GOMEMLIMIT=256MiB
CHECKER_HEALTH_ADDR=127.0.0.1:8097
